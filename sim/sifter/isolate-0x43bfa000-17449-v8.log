script-source,89,file:///home/user/world/sim/sifter/patterns.js,// Declarative storyline patterns. Matchers are event types (wildcards 'life.*') or 'tag:<tag>'; patterns tolerate other packs' naming by also matching tags.\n// window = days of silence before an arc lapses. min = beats needed to count as a confirmed arc. Add patterns freely; no code changes elsewhere.\nconst NEG = ['work.fired'\x2C 'home.eviction'\x2C 'money.debt'\x2C 'health.diagnosis'\x2C 'life.breakup'\x2C 'biz.close'\x2C 'tag:setback'];\nconst POS = ['work.hired'\x2C 'work.promoted'\x2C 'money.windfall'\x2C 'biz.open'\x2C 'life.graduate'\x2C 'school.result'\x2C 'tag:success'];\nexport const PATTERNS = [\n  { kind: 'courtship'\x2C scope: 'pair'\x2C window: 200\x2C min: 2\x2C stages: [{ name: 'meet'\x2C m: ['social.friendship'\x2C 'social.flirt'\x2C 'tag:flirt'] }\x2C { name: 'dating'\x2C m: ['life.couple'\x2C 'social.date'\x2C 'tag:romance']\x2C repeat: true }\x2C { name: 'commit'\x2C m: ['life.engaged'\x2C 'life.marriage'\x2C 'life.cohabit'\x2C 'home.move_together']\x2C terminal: true\x2C outcome: 'committed' }] }\x2C\n  { kind: 'romance'\x2C scope: 'pair'\x2C window: 600\x2C min: 2\x2C stages: [{ name: 'together'\x2C m: ['life.couple'] }\x2C { name: 'bond'\x2C m: ['life.cohabit'\x2C 'life.engaged'\x2C 'life.marriage'\x2C 'life.birth'\x2C 'home.move_together']\x2C repeat: true }\x2C { name: 'end'\x2C m: ['life.breakup'\x2C 'life.divorce'\x2C 'life.death']\x2C terminal: true\x2C outcome: 'ended' }] }\x2C\n  { kind: 'breakup'\x2C scope: 'pair'\x2C window: 90\x2C min: 2\x2C stages: [{ name: 'rupture'\x2C m: ['life.breakup'\x2C 'life.divorce'] }\x2C { name: 'fallout'\x2C m: ['social.fallout'\x2C 'home.flatmate_leave'\x2C 'life.move_out'\x2C 'money.dispute']\x2C repeat: true }\x2C { name: 'settled'\x2C m: ['social.reconcile'\x2C 'life.couple']\x2C terminal: true\x2C outcome: 'settled' }] }\x2C\n  { kind: 'rivalry'\x2C scope: 'pair'\x2C window: 400\x2C min: 3\x2C stages: [{ name: 'spark'\x2C m: ['social.fallout'\x2C 'crime.antisocial'\x2C 'tag:conflict'] }\x2C { name: 'escalation'\x2C m: ['social.fallout'\x2C 'social.insult'\x2C 'crime.antisocial'\x2C 'civic.complaint'\x2C 'tag:conflict']\x2C repeat: true }\x2C { name: 'truce'\x2C m: ['social.reconcile']\x2C terminal: true\x2C outcome: 'reconciled' }] }\x2C\n  { kind: 'feud'\x2C scope: 'pair'\x2C window: 700\x2C min: 5\x2C stages: [{ name: 'spark'\x2C m: ['social.fallout'\x2C 'tag:conflict'] }\x2C { name: 'escalation'\x2C m: ['social.fallout'\x2C 'social.insult'\x2C 'crime.*'\x2C 'civic.complaint'\x2C 'tag:conflict']\x2C repeat: true }] }\x2C\n  { kind: 'revenge'\x2C scope: 'pair'\x2C window: 500\x2C min: 2\x2C stages: [{ name: 'wrong'\x2C m: ['crime.*'\x2C 'social.betray'\x2C 'social.fallout'\x2C 'work.fired'\x2C 'tag:harm'] }\x2C { name: 'retaliation'\x2C m: ['crime.*'\x2C 'social.fallout'\x2C 'social.rumour'\x2C 'tag:harm']\x2C dir: 'reverse'\x2C terminal: true\x2C outcome: 'avenged' }] }\x2C\n  { kind: 'rise'\x2C scope: 'person'\x2C window: 500\x2C min: 3\x2C stages: [{ name: 'step'\x2C m: POS\x2C repeat: true }]\x2C compose: [{ kind: 'redemption'\x2C after: 'fall'\x2C then: 'rise'\x2C within: 700\x2C outcome: 'redeemed' }\x2C { kind: 'comeback'\x2C after: 'jobloss'\x2C then: 'rise'\x2C within: 500\x2C outcome: 'recovered' }] }\x2C\n  { kind: 'fall'\x2C scope: 'person'\x2C window: 400\x2C min: 3\x2C stages: [{ name: 'setback'\x2C m: NEG\x2C repeat: true }\x2C { name: 'bottom'\x2C m: ['life.death'\x2C 'crime.arrest'\x2C 'health.crisis']\x2C terminal: true\x2C outcome: 'bottomed' }] }\x2C\n  { kind: 'jobloss'\x2C scope: 'person'\x2C window: 400\x2C min: 2\x2C stages: [{ name: 'loss'\x2C m: ['work.fired'\x2C 'work.redundant'\x2C 'work.quit'] }\x2C { name: 'strain'\x2C m: ['money.debt'\x2C 'home.rent_rise'\x2C 'social.fallout'\x2C 'health.diagnosis']\x2C repeat: true }\x2C { name: 'recovery'\x2C m: ['work.hired'\x2C 'work.promoted']\x2C terminal: true\x2C outcome: 'recovered' }] }\x2C\n  { kind: 'debt_spiral'\x2C scope: 'person'\x2C window: 300\x2C min: 3\x2C stages: [{ name: 'debt'\x2C m: ['money.debt'\x2C 'home.rent_rise']\x2C repeat: true }\x2C { name: 'crisis'\x2C m: ['home.eviction'\x2C 'money.bankruptcy'\x2C 'crime.theft']\x2C terminal: true\x2C outcome: 'crisis' }] }\x2C\n  { kind: 'eviction_chain'\x2C scope: 'person'\x2C window: 200\x2C min: 3\x2C stages: [{ name: 'notice'\x2C m: ['home.eviction'] }\x2C { name: 'scramble'\x2C m: ['life.move_out'\x2C 'money.debt'\x2C 'home.flatmate_join'\x2C 'life.move_in']\x2C repeat: true }\x2C { name: 'rehoused'\x2C m: ['life.move_in'\x2C 'home.bought']\x2C terminal: true\x2C outcome: 'rehoused' }] }\x2C\n  { kind: 'scandal'\x2C scope: 'person'\x2C window: 250\x2C min: 3\x2C stages: [{ name: 'secret'\x2C m: ['social.secret'\x2C 'crime.*'\x2C 'tag:secret'] }\x2C { name: 'spread'\x2C m: ['social.rumour'\x2C 'tag:gossip']\x2C repeat: true }\x2C { name: 'revealed'\x2C m: ['social.scandal'\x2C 'civic.scandal'\x2C 'crime.arrest']\x2C terminal: true\x2C outcome: 'exposed' }] }\x2C\n  { kind: 'underdog'\x2C scope: 'person'\x2C window: 600\x2C min: 3\x2C stages: [{ name: 'against'\x2C m: ['work.fired'\x2C 'biz.close'\x2C 'school.fail'\x2C 'tag:setback'] }\x2C { name: 'effort'\x2C m: ['school.result'\x2C 'work.hired'\x2C 'biz.open'\x2C 'civic.campaign']\x2C repeat: true }\x2C { name: 'win'\x2C m: ['work.promoted'\x2C 'money.windfall'\x2C 'civic.win'\x2C 'tag:success']\x2C terminal: true\x2C outcome: 'triumph' }] }\x2C\n  { kind: 'coming_of_age'\x2C scope: 'person'\x2C window: 900\x2C min: 4\x2C stages: [{ name: 'first'\x2C m: ['school.result'\x2C 'life.graduate'\x2C 'work.hired'\x2C 'life.move_out'\x2C 'life.couple'\x2C 'tag:first']\x2C repeat: true\x2C guard: (ev) => (ev.payload?.age ?? 18) <= 26 }] }\x2C\n  { kind: 'found_family'\x2C scope: 'object'\x2C window: 500\x2C min: 4\x2C stages: [{ name: 'gather'\x2C m: ['home.flatmate_join'\x2C 'social.friendship'] }\x2C { name: 'bond'\x2C m: ['social.friendship'\x2C 'social.reconcile'\x2C 'social.kindness'\x2C 'tag:support']\x2C repeat: true }] }\x2C\n  { kind: 'flatshare_saga'\x2C scope: 'object'\x2C window: 400\x2C min: 4\x2C stages: [{ name: 'move_in'\x2C m: ['home.flatmate_join']\x2C repeat: true }\x2C { name: 'friction'\x2C m: ['social.fallout'\x2C 'home.rent_rise'\x2C 'money.dispute'\x2C 'home.flatmate_leave']\x2C repeat: true }] }\x2C\n  { kind: 'business_saga'\x2C scope: 'object'\x2C window: 700\x2C min: 3\x2C stages: [{ name: 'open'\x2C m: ['biz.open'] }\x2C { name: 'trade'\x2C m: ['biz.*'\x2C 'money.debt'\x2C 'money.windfall'\x2C 'civic.campaign']\x2C repeat: true }\x2C { name: 'close'\x2C m: ['biz.close']\x2C terminal: true\x2C outcome: 'closed' }] }\x2C\n  { kind: 'newcomer'\x2C scope: 'person'\x2C window: 400\x2C min: 3\x2C stages: [{ name: 'arrive'\x2C m: ['life.move_in'\x2C 'tag:newcomer'] }\x2C { name: 'settle'\x2C m: ['social.friendship'\x2C 'work.hired'\x2C 'civic.campaign'\x2C 'social.kindness'\x2C 'life.couple']\x2C repeat: true }\x2C { name: 'leave'\x2C m: ['life.move_out']\x2C terminal: true\x2C outcome: 'left' }] }\x2C\n  { kind: 'isolation_rescue'\x2C scope: 'person'\x2C window: 400\x2C min: 2\x2C stages: [{ name: 'isolated'\x2C m: ['social.isolation'\x2C 'tag:lonely'\x2C 'life.death'] }\x2C { name: 'rescued'\x2C m: ['social.kindness'\x2C 'social.friendship'\x2C 'civic.campaign'\x2C 'tag:support']\x2C terminal: true\x2C outcome: 'rescued' }] }\x2C\n  { kind: 'bereavement'\x2C scope: 'person'\x2C window: 500\x2C min: 3\x2C allActors: true\x2C stages: [{ name: 'death'\x2C m: ['life.death'] }\x2C { name: 'aftermath'\x2C m: ['health.diagnosis'\x2C 'work.quit'\x2C 'life.move_out'\x2C 'money.debt'\x2C 'social.kindness'\x2C 'life.move_in']\x2C repeat: true }] }\x2C\n  { kind: 'moving_on'\x2C scope: 'person'\x2C allActors: true\x2C window: 300\x2C min: 2\x2C stages: [{ name: 'ended'\x2C m: ['life.breakup'\x2C 'life.divorce'] }\x2C { name: 'new_start'\x2C m: ['life.move_out'\x2C 'life.move_in'\x2C 'work.hired'\x2C 'life.couple']\x2C repeat: true\x2C terminal: false }] }\x2C\n  { kind: 'neighbourhood_campaign'\x2C scope: 'place'\x2C window: 300\x2C min: 3\x2C stages: [{ name: 'launch'\x2C m: ['civic.campaign'] }\x2C { name: 'rally'\x2C m: ['civic.*'\x2C 'social.kindness']\x2C repeat: true }] }\x2C\n  { kind: 'windfall'\x2C scope: 'person'\x2C window: 200\x2C min: 2\x2C stages: [{ name: 'windfall'\x2C m: ['money.windfall'] }\x2C { name: 'spend'\x2C m: ['life.move_in'\x2C 'home.bought'\x2C 'biz.open'\x2C 'money.debt'\x2C 'social.fallout']\x2C repeat: true }] }\x2C\n];\nexport const KINDS = PATTERNS.map((p) => p.kind).concat(['redemption'\x2C 'comeback']);\n
