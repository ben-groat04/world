script-source,86,file:///home/user/world/sim/sifter/selftest.js,// node sim/sifter/selftest.js : synthetic event log with known storylines + noise; asserts detection and perf.\nimport { Sifter } from './sifter.js';\nimport { PATTERNS } from './patterns.js';\nlet id = 0; const D = 144; const log = [];\nconst E = (type\x2C day\x2C actors\x2C o = {}) => { const e = { id: id++\x2C type\x2C tick: day * D\x2C actors\x2C objects: o.objects || []\x2C place: o.place ?? null\x2C tags: o.tags || []\x2C cause: o.cause ?? -1\x2C salience: o.sal ?? 0.4\x2C payload: o.payload || {} }; log.push(e); return e.id; };\n// rivalry (1\x2C2) with truce; romance (3\x2C4); fall then rise (5) => redemption; revenge 6->7 then 7->6; business saga biz 90; flatshare house 70; scandal 8; noise\nE('social.fallout'\x2C 1\x2C [1\x2C 2]); E('social.insult'\x2C 9\x2C [2\x2C 1]); E('crime.antisocial'\x2C 20\x2C [1\x2C 2]); E('social.fallout'\x2C 40\x2C [2\x2C 1]); E('social.reconcile'\x2C 80\x2C [1\x2C 2]);\nE('social.friendship'\x2C 5\x2C [3\x2C 4]); E('life.couple'\x2C 30\x2C [3\x2C 4]); E('life.cohabit'\x2C 120\x2C [3\x2C 4]); E('life.marriage'\x2C 300\x2C [3\x2C 4]);\nconst f1 = E('work.fired'\x2C 10\x2C [5]); const d1 = E('money.debt'\x2C 14\x2C [5]\x2C { cause: f1 }); const ev1 = E('home.eviction'\x2C 30\x2C [5]\x2C { cause: d1\x2C objects: [88] }); E('life.move_out'\x2C 31\x2C [5]\x2C { cause: ev1 }); E('life.move_in'\x2C 50\x2C [5]);\nE('work.hired'\x2C 400\x2C [5]); E('work.promoted'\x2C 520\x2C [5]); E('money.windfall'\x2C 640\x2C [5]);\nE('crime.theft'\x2C 5\x2C [6\x2C 7]); E('crime.vandalism'\x2C 60\x2C [7\x2C 6]);\nE('biz.open'\x2C 2\x2C [9]\x2C { objects: [90] }); E('biz.hire'\x2C 100\x2C [9]\x2C { objects: [90] }); E('money.debt'\x2C 250\x2C [9]\x2C { objects: [90] }); E('biz.close'\x2C 400\x2C [9]\x2C { objects: [90] });\nfor (let i = 0; i < 5; i++) E('home.flatmate_join'\x2C 10 + i * 40\x2C [20 + i]\x2C { objects: [70] }); E('social.fallout'\x2C 260\x2C [20\x2C 21]\x2C { objects: [70] });\nE('social.secret'\x2C 3\x2C [8]); E('social.rumour'\x2C 9\x2C [8]); E('social.rumour'\x2C 15\x2C [8]); E('social.scandal'\x2C 22\x2C [8]);\nconst sorted = log.sort((a\x2C b) => a.tick - b.tick || a.id - b.id);\nconst S = new Sifter({ patterns: PATTERNS\x2C ticksPerDay: D });\nfor (const e of sorted) S.consume(e);\nS.sweep(1e9);\nconst kinds = new Set(S.arcs.filter((a) => a.confirmed).map((a) => a.kind));\nconst want = ['rivalry'\x2C 'romance'\x2C 'courtship'\x2C 'fall'\x2C 'rise'\x2C 'redemption'\x2C 'revenge'\x2C 'business_saga'\x2C 'flatshare_saga'\x2C 'scandal'\x2C 'eviction_chain'];\nconst missing = want.filter((k) => !kinds.has(k));\nfor (const a of S.ranked(12\x2C { includeQuiet: true })) console.log(S.summarise(a));\nconsole.log('stats'\x2C JSON.stringify(S.stats()));\n// perf: 10 sim-years x 500 pop ~ 150k events of mostly noise\nconst T0 = process.hrtime.bigint(); const P = new Sifter({ patterns: PATTERNS\x2C ticksPerDay: D }); let seed = 1; const r = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);\nconst types = ['life.couple'\x2C 'work.fired'\x2C 'work.hired'\x2C 'social.fallout'\x2C 'social.friendship'\x2C 'money.debt'\x2C 'home.rent_rise'\x2C 'biz.open'\x2C 'life.move_out'\x2C 'social.reconcile'\x2C 'life.move_in'\x2C 'civic.campaign'\x2C 'school.result'\x2C 'conversation.chat'\x2C 'shop.buy'\x2C 'work.shift'\x2C 'health.diagnosis'];\nconst N = 150000; let last = -1;\nfor (let i = 0; i < N; i++) { const t = types[Math.floor(r() * r() * types.length)]; const a = Math.floor(r() * 500)\x2C b = Math.floor(r() * 500); P.consume({ id: i\x2C type: t\x2C tick: Math.floor((i / N) * 3650 * D)\x2C actors: [a\x2C b]\x2C objects: [Math.floor(r() * 200)]\x2C place: Math.floor(r() * 60)\x2C tags: []\x2C cause: r() < 0.3 && last >= 0 ? last : -1\x2C salience: 0.3\x2C payload: {} }); last = i; }\nconst ms = Number(process.hrtime.bigint() - T0) / 1e6;\nconsole.log(`perf: ${N} events in ${ms.toFixed(0)}ms (${(ms / N * 1000).toFixed(1)}us/event); arcs ${P.arcs.length}\x2C confirmed ${P.stats().arcs}`);\nif (missing.length) { console.log('MISSING'\x2C missing.join('\x2C')); process.exit(1); }\nif (ms > 2000) { console.log('TOO SLOW'); process.exit(1); }\nconsole.log('sifter selftest ok');\n
