script-source,88,file:///home/user/world/sim/sifter/sifter.js,// Incremental arc sifter. consume(ev) per emitted event (cheap: O(#patterns matching ev.type)); arcs live in sifter.arcs (a.k.a. world.arcs).\n// Event shape: {id\x2Ctype\x2Ctick\x2Cactors\x2Cobjects\x2Cplace\x2Ctags\x2Ccause\x2Csalience\x2Cpayload}. Pure over plain data\x2C no kernel dependency.\n// Pattern DSL (see patterns.js): {kind\x2C scope:'pair'|'person'|'object'|'place'\x2C window:days\x2C min:beats\x2C stages:[{name\x2Cm:[matchers]\x2Crepeat?\x2Cterminal?\x2Coutcome?\x2Cdir?:'reverse'\x2Cguard?}]\x2C compose?}\n// matcher: 'life.couple' | 'life.*' | 'tag:romance'.  An arc opens on a stage-0 match\x2C advances monotonically through stages\x2C and closes on a terminal stage or lapses after `window` days silent.\nconst DOMAIN = (t) => t.split('.')[0];\nexport class Sifter {\n  /** @param {{ticksPerDay?:number\x2C patterns:Array\x2C quietBelow?:number\x2C keepDepth?:number}} o */\n  constructor(o) {\n    this.tpd = o.ticksPerDay || 144; this.patterns = o.patterns; this.quietBelow = o.quietBelow ?? 1.2;\n    this.arcs = []; this.open = new Map(); this.byCause = new Map(); this.depth = new Map(); this.nextId = 1; this.consumed = 0; this.lastSweep = 0; this.composed = new Set(); this.byActorIdx = new Map(); this.thenKinds = new Set(o.patterns.flatMap((p) => (p.compose || []).map((c) => c.then)));\n    this.exact = new Map(); this.wild = new Map(); this.tagIdx = new Map();\n    this.patterns.forEach((p\x2C pi) => p.stages.forEach((s\x2C si) => s.m.forEach((m) => {\n      const [map\x2C key] = m.startsWith('tag:') ? [this.tagIdx\x2C m.slice(4)] : m.endsWith('.*') ? [this.wild\x2C m.slice(0\x2C -2)] : [this.exact\x2C m];\n      if (!map.has(key)) map.set(key\x2C []); map.get(key).push([pi\x2C si]);\n    })));\n  }\n  _cands(ev) {\n    const out = []; const a = this.exact.get(ev.type); if (a) out.push(...a);\n    const w = this.wild.get(DOMAIN(ev.type)); if (w) out.push(...w);\n    if (ev.tags) for (const t of ev.tags) { const x = this.tagIdx.get(t); if (x) out.push(...x); }\n    return out;\n  }\n  _keys(p\x2C ev) {\n    const A = ev.actors || [];\n    switch (p.scope) {\n      case 'pair': return A.length >= 2 && A[0] !== A[1] ? [A[0] < A[1] ? `${A[0]}-${A[1]}` : `${A[1]}-${A[0]}`] : [];\n      case 'person': return A.slice(0\x2C p.allActors ? 3 : 1).map(String);\n      case 'object': return ev.objects?.length ? [String(ev.objects[0])] : [];\n      case 'place': return ev.place != null ? [String(ev.place)] : [];\n      default: return [];\n    }\n  }\n  consume(ev) {\n    this.consumed++;\n    const cd = ev.cause >= 0 && this.depth.has(ev.cause) ? this.depth.get(ev.cause) + 1 : 0; this.depth.set(ev.id\x2C cd);\n    const touched = new Set();\n    const seen = new Set();\n    for (const [pi\x2C si] of this._cands(ev)) {\n      const p = this.patterns[pi]; const st = p.stages[si]; if (seen.has(pi * 64 + si)) continue; seen.add(pi * 64 + si);\n      for (const key of this._keys(p\x2C ev)) {\n        const ok = `${p.kind}|${key}`; let arc = this.open.get(ok);\n        if (arc && ev.tick - arc.last > p.window * this.tpd) { this._close(arc\x2C 'lapsed'); arc = null; }\n        if (!arc) { if (si !== 0 || (st.guard && !st.guard(ev\x2C null))) continue; arc = this._open(p\x2C key\x2C ev); this.open.set(ok\x2C arc); }\n        else {\n          if (si < arc.stageIdx && !(p.stages[si].repeat && si > 0)) continue;\n          if (si === 0 && arc.stageIdx === 0 && !st.repeat && arc.beats.length) { if (!st.reopen) continue; }\n          if (st.dir === 'reverse' && ev.actors[0] !== arc.actors[1]) continue;\n          if (st.guard && !st.guard(ev\x2C arc)) continue;\n          if (arc.beats.some((b) => b.eid === ev.id)) continue;\n        }\n        this._beat(arc\x2C ev\x2C st\x2C si\x2C cd); touched.add(arc);\n        if (st.terminal) this._close(arc\x2C st.outcome || 'resolved');\n      }\n    }\n    // causal attach: events caused by an arc's events join it as consequences (cross-system reach)\n    if (ev.cause >= 0 && this.byCause.has(ev.cause)) {\n      for (const arc of this.byCause.get(ev.cause)) if (arc.status === 'open' && !touched.has(arc) && arc.beats.length < 40) { this._beat(arc\x2C ev\x2C { name: 'consequence' }\x2C arc.stageIdx\x2C cd); touched.add(arc); }\n    }\n    for (const arc of touched) { this._score(arc); if (arc.confirmed && this.thenKinds.has(arc.kind)) this._compose(arc); }\n    if (ev.tick - this.lastSweep > 7 * this.tpd) this.sweep(ev.tick);\n  }\n  _open(p\x2C key\x2C ev) {\n    const arc = { id: this.nextId++\x2C kind: p.kind\x2C scope: p.scope\x2C key\x2C actors: ev.actors.slice(0\x2C 3)\x2C status: 'open'\x2C outcome: null\x2C stage: p.stages[0].name\x2C stageIdx: 0\x2C start: ev.tick\x2C last: ev.tick\x2C beats: []\x2C systems: new Set()\x2C maxDepth: 0\x2C score: 0\x2C quiet: true\x2C confirmed: false\x2C sig: ''\x2C pat: p };\n    return arc;\n  }\n  _register(arc) { this.arcs.push(arc); for (const a of arc.actors) { let l = this.byActorIdx.get(a); if (!l) this.byActorIdx.set(a\x2C l = []); l.push(arc); } }\n  _beat(arc\x2C ev\x2C st\x2C si\x2C depth) {\n    arc.beats.push({ eid: ev.id\x2C tick: ev.tick\x2C type: ev.type\x2C stage: st.name\x2C sal: ev.salience ?? 0.3\x2C depth });\n    arc.last = ev.tick; if (si > arc.stageIdx) { arc.stageIdx = si; arc.stage = st.name; }\n    arc.systems.add(DOMAIN(ev.type)); if (depth > arc.maxDepth) arc.maxDepth = depth;\n    for (const a of ev.actors || []) if (!arc.actors.includes(a) && arc.actors.length < 4) arc.actors.push(a);\n    let l = this.byCause.get(ev.id); if (!l) this.byCause.set(ev.id\x2C l = []); l.push(arc);\n  }\n  _score(arc) {\n    let s = 0\x2C n = 0; for (const b of arc.beats) { s += b.sal; n++; }\n    arc.score = s + 0.4 * arc.maxDepth + 0.6 * (arc.systems.size - 1) + (arc.status === 'resolved' ? 0.5 : 0);\n    const was = arc.confirmed; arc.confirmed = arc.beats.length >= (arc.pat.min || 2); if (arc.confirmed && !was && !arc.registered) { arc.registered = true; this._register(arc); }\n    arc.quiet = arc.score < this.quietBelow;\n    const path = []; for (const b of arc.beats) if (path[path.length - 1]?.[0] !== b.stage) path.push([b.stage\x2C 1]); else path[path.length - 1][1]++;\n    arc.sig = `${arc.kind}:${path.map((x) => x[0]).join('>')}${arc.outcome ? '=' + arc.outcome : ''}`;\n  }\n  _close(arc\x2C outcome) {\n    if (arc.status !== 'open') return;\n    arc.status = outcome === 'lapsed' ? 'lapsed' : 'resolved'; arc.outcome = outcome; this.open.delete(`${arc.kind}|${arc.key}`);\n    this._score(arc); if (arc.confirmed && this.thenKinds.has(arc.kind)) this._compose(arc);\n  }\n  /** Two-arc compositions: pattern.compose = [{kind:'redemption'\x2C after:'fall'\x2C within:days}] fires when this arc (kind second) is confirmed and a finished `after` arc exists on a shared actor. */\n  _compose(arc) {\n    for (const p of this.patterns) for (const c of p.compose || []) {\n      if (c.then !== arc.kind) continue; const actor = arc.actors[0];\n      const id = `${c.kind}|${arc.id}`; if (this.composed.has(id)) continue;\n      for (const o of this.byActorIdx.get(actor) || []) {\n        if (o === arc || o.kind !== c.after || !o.confirmed || !o.actors.includes(actor)) continue;\n        if (c.needClosed !== false && o.status === 'open') continue;\n        if (arc.start < o.last || arc.start - o.last > c.within * this.tpd) continue;\n        this.composed.add(id);\n        const m = { kind: c.kind\x2C scope: 'person'\x2C key: String(actor)\x2C actors: [actor]\x2C status: arc.status === 'open' ? 'open' : 'resolved'\x2C outcome: c.outcome || null\x2C stage: 'composite'\x2C stageIdx: 0\x2C start: o.start\x2C last: arc.last\x2C beats: [...o.beats\x2C ...arc.beats].sort((x\x2C y) => x.tick - y.tick)\x2C systems: new Set([...o.systems\x2C ...arc.systems])\x2C maxDepth: Math.max(o.maxDepth\x2C arc.maxDepth)\x2C score: 0\x2C quiet: true\x2C confirmed: true\x2C sig: ''\x2C pat: { min: 1 }\x2C parts: [o.id\x2C arc.id] };\n        m.registered = true; this._register(m); this._score(m); m.sig = `${c.kind}:${o.sig.split(':')[0]}>${arc.kind}`; m.score += 0.8; m.quiet = m.score < this.quietBelow; break;\n      }\n    }\n  }\n  sweep(tick) {\n    this.lastSweep = tick;\n    for (const arc of [...this.open.values()]) if (tick - arc.last > arc.pat.window * this.tpd) this._close(arc\x2C 'lapsed');\n    if (this.depth.size > 20000) { let n = 0; for (const k of this.depth.keys()) { this.depth.delete(k); this.byCause.delete(k); if (++n > 10000) break; } }\n  }\n  ranked(n = 10\x2C { minScore = 0\x2C includeQuiet = false\x2C kind } = {}) {\n    return this.arcs.filter((a) => a.confirmed && (includeQuiet || !a.quiet) && a.score >= minScore && (!kind || a.kind === kind)).sort((a\x2C b) => b.score - a.score).slice(0\x2C n);\n  }\n  byActor(id) { return (this.byActorIdx.get(id) || []).filter((a) => a.confirmed); }\n  /** Plain summary with causal-chain stats. */\n  summarise(arc\x2C names = (id) => `#${id}`) {\n    const stages = []; for (const b of arc.beats) if (stages[stages.length - 1]?.stage !== b.stage) stages.push({ stage: b.stage\x2C n: 1\x2C tick: b.tick }); else stages[stages.length - 1].n++;\n    return `${arc.kind} [${arc.status}${arc.outcome ? ':' + arc.outcome : ''}] ${arc.actors.map(names).join(' & ')}: ${stages.map((s) => s.stage + (s.n > 1 ? 'x' + s.n : '')).join(' > ')} over ${Math.round((arc.last - arc.start) / this.tpd)}d\x2C ${arc.beats.length} beats\x2C ${arc.systems.size} systems\x2C depth ${arc.maxDepth}${arc.quiet ? ' (quiet)' : ''}`;\n  }\n  stats() {\n    const c = this.arcs.filter((a) => a.confirmed); const byKind = {}; for (const a of c) byKind[a.kind] = (byKind[a.kind] || 0) + 1;\n    return { events: this.consumed\x2C arcs: c.length\x2C open: this.open.size\x2C byKind\x2C quiet: c.filter((a) => a.quiet).length };\n  }\n  serialize() { return { v: 1\x2C nextId: this.nextId\x2C arcs: this.arcs.map((a) => ({ ...a\x2C systems: [...a.systems]\x2C pat: undefined\x2C patKind: a.kind })) }; }\n}\n
